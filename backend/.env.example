# ─── Supabase PostgreSQL (voice-agency project) ───────────────────────────────
# Get from: https://supabase.com/dashboard/project/ifxijwxylnwxgrrnjqyi/settings/database
DATABASE_URL="postgresql://postgres.ifxijwxylnwxgrrnjqyi:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.ifxijwxylnwxgrrnjqyi:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ─── Redis (Upstash - India region recommended) ───────────────────────────────
# Get from: https://upstash.com  → Create Redis → Mumbai region
REDIS_URL="rediss://:[PASSWORD]@your-upstash-endpoint.upstash.io:6380"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
SERVER_ID="srv-1"   # unique per server instance (srv-1, srv-2, srv-3...)

# ─── Vobiz Telephony (https://console.vobiz.ai) ───────────────────────────────
VOBIZ_API_KEY="your_vobiz_api_key"
VOBIZ_API_BASE_URL="https://api.vobiz.ai/v1"
VOBIZ_WEBHOOK_BASE_URL="https://api.yourplatform.com"
VOBIZ_FROM_NUMBER="+91XXXXXXXXXX"

# ─── Gemini Live API (https://aistudio.google.com/apikey) ────────────────────
GEMINI_API_KEY="your_gemini_api_key"

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL="https://yourplatform.com"
