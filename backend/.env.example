# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/voice_ai_platform"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Vobiz Telephony (https://console.vobiz.ai)
VOBIZ_API_KEY="your_vobiz_api_key"
VOBIZ_API_BASE_URL="https://api.vobiz.ai/v1"
VOBIZ_WEBHOOK_BASE_URL="https://your-ngrok-url.ngrok.io"
VOBIZ_FROM_NUMBER="+91XXXXXXXXXX"

# Gemini Live API (https://aistudio.google.com/apikey)
GEMINI_API_KEY="your_gemini_api_key"

# Frontend
FRONTEND_URL="http://localhost:3000"
