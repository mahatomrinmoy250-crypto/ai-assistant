# JARVIS AI Voice Assistant — Environment Configuration
# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────────────
# Anthropic API key — get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# ── Gmail (for email read/reply/auto-reply) ───────────
# Your Gmail address
GMAIL_ADDRESS=you@gmail.com
# App Password (NOT your real password!)
# How to generate: Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Facebook (for post/comment automation) ────────────
# Your Facebook login email
FB_EMAIL=you@email.com
# Your Facebook password
FB_PASSWORD=your_facebook_password
